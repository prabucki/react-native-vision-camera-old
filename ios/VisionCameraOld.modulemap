framework module VisionCameraOld {
  umbrella header "VisionCameraOld.h"

  // Only include our clean interface headers
  header "VisionCameraOldTypes.h"
  header "FrameOld.h"
  header "FrameProcessorCallback.h"
  header "FrameProcessorPlugin.h"
  header "FrameProcessorPluginRegistryOld.h"

  // Exclude ALL potentially problematic headers
  exclude header "CameraBridge.h"
  exclude header "FrameProcessorRuntimeManagerOld.h"
  exclude header "FrameHostObjectOld.h"
  exclude header "RCTBridge+runOnJS.h"
  exclude header "JSConsoleHelper.h"
  exclude header "VisionCameraOldScheduler.h"
  exclude header "JSIUtils.h"
  exclude header "VisionCameraOldWrapper.h"

  // Exclude any Swift-generated or implementation files
  exclude header "VisionCameraOld-Swift.h"
  exclude header "*.mm"

  export *
  module * { export * }

  requires objc
}
